package templates

import (
	"database/sql"
	"fmt"

	"github.com/mbertschler/squirrel/runevents"
	"github.com/mbertschler/squirrel/store"
)

// RunRow bundles a run with the volume name resolved (so the template
// doesn't reach into the store layer).
type RunRow struct {
	Run        store.Run
	VolumeName string
}

templ RunsPage(rows []RunRow) {
	@PageHeader("Runs", "Recent index, sync, restore, and audit runs.")
	<section class="p-6">
		<div class="card overflow-hidden">
			<table class="w-full text-sm">
				<thead class="text-left text-xs uppercase tracking-wide text-muted-foreground bg-muted/30">
					<tr>
						<th class="px-4 py-2 font-medium">#</th>
						<th class="px-4 py-2 font-medium">Kind</th>
						<th class="px-4 py-2 font-medium">Mode</th>
						<th class="px-4 py-2 font-medium">Volume</th>
						<th class="px-4 py-2 font-medium">Destination</th>
						<th class="px-4 py-2 font-medium">Started</th>
						<th class="px-4 py-2 font-medium">Ended</th>
						<th class="px-4 py-2 font-medium">Status</th>
						<th class="px-4 py-2 font-medium text-right">Files</th>
					</tr>
				</thead>
				<tbody>
					if len(rows) == 0 {
						<tr><td colspan="9" class="px-4 py-6 text-center text-muted-foreground">no runs yet</td></tr>
					}
					for _, r := range rows {
						<tr class="border-t border-border">
							<td class="px-4 py-1.5 tabular-nums">
								<a class="hover:underline" href={ templ.URL("/runs/" + fmt.Sprintf("%d", r.Run.ID)) }>{ fmt.Sprintf("%d", r.Run.ID) }</a>
							</td>
							<td class="px-4 py-1.5">{ r.Run.Kind }</td>
							<td class="px-4 py-1.5">@shallowBadge(r.Run.Shallow)</td>
							<td class="px-4 py-1.5">{ r.VolumeName }</td>
							<td class="px-4 py-1.5 text-muted-foreground">
								if r.Run.Destination.Valid {
									{ r.Run.Destination.String }
								} else {
									—
								}
							</td>
							<td class="px-4 py-1.5 text-muted-foreground tabular-nums">{ fmtTime(r.Run.StartedAtNs) }</td>
							<td class="px-4 py-1.5 text-muted-foreground tabular-nums">
								if r.Run.EndedAtNs.Valid {
									{ fmtTime(r.Run.EndedAtNs.Int64) }
								} else {
									—
								}
							</td>
							<td class="px-4 py-1.5">@runStatusBadge(r.Run.Status)</td>
							<td class="px-4 py-1.5 text-right tabular-nums">{ fmt.Sprintf("%d", r.Run.FileCount) }</td>
						</tr>
					}
				</tbody>
			</table>
		</div>
	</section>
}

// shallowBadge renders runs.shallow as a compact mode badge. NULL —
// the pre-v10 / sync-restore case — stays muted because we have nothing
// honest to claim about the run's hashing strategy.
templ shallowBadge(s sql.NullBool) {
	if !s.Valid {
		<span class="text-muted-foreground">—</span>
	} else if s.Bool {
		<span class="rounded-md px-2 py-0.5 text-xs bg-amber-500/15 text-amber-700 dark:text-amber-400" title="skipped rehash when size and mtime matched">shallow</span>
	} else {
		<span class="rounded-md px-2 py-0.5 text-xs bg-muted text-muted-foreground" title="rehashed every file">full</span>
	}
}

templ runStatusBadge(s string) {
	switch s {
	case "running":
		<span class="rounded-md px-2 py-0.5 text-xs bg-primary/15 text-primary">running</span>
	case "success":
		<span class="rounded-md px-2 py-0.5 text-xs bg-emerald-500/15 text-emerald-700 dark:text-emerald-400">success</span>
	case "failed":
		<span class="rounded-md px-2 py-0.5 text-xs bg-destructive/15 text-destructive">failed</span>
	case "partial":
		<span class="rounded-md px-2 py-0.5 text-xs bg-amber-500/15 text-amber-700 dark:text-amber-400">partial</span>
	default:
		<span class="rounded-md px-2 py-0.5 text-xs bg-muted text-muted-foreground">{ s }</span>
	}
}

templ RunDetailPage(row RunRow, errMsg string) {
	@PageHeader(fmt.Sprintf("Run #%d", row.Run.ID), row.Run.Kind+" · "+row.VolumeName)
	<section class="p-6 space-y-4">
		// The SSE controller below opens an EventSource against
		// /runs/{id}/events; each event payload is one turbo-stream
		// frame targeting #run-status, so progress lands by mutating
		// just the panel below without unmounting the controller (which
		// would tear down the live channel). The status panel renders
		// the latest stored row inline so initial page load is useful
		// even before the first SSE frame arrives.
		<div data-controller="sse" data-sse-url-value={ fmt.Sprintf("/runs/%d/events", row.Run.ID) }>
			@RunStatusFrame(row, runevents.Progress{})
		</div>
		if errMsg != "" {
			<div class="card p-4 text-sm">
				<div class="text-muted-foreground mb-1">Error</div>
				<div class="text-destructive">{ errMsg }</div>
			</div>
		}
		<a class="btn btn-outline btn-sm" href="/runs">All runs</a>
	</section>
}

// RunStatusFrame is the per-event payload of the SSE stream and the
// initial inline render inside RunDetailPage. Wrapping in a turbo-stream
// makes the client-side swap automatic: the SSE controller just shoves
// each event into Turbo.renderStreamMessage and Turbo finds the
// matching #run-status target itself.
templ RunStatusFrame(row RunRow, p runevents.Progress) {
	<turbo-stream action="replace" target="run-status">
		<template>
			@runStatusPanel(row, p)
		</template>
	</turbo-stream>
}

templ runStatusPanel(row RunRow, p runevents.Progress) {
	<div id="run-status" class="card p-4 grid grid-cols-2 gap-x-8 gap-y-3 text-sm">
		<dt class="text-muted-foreground">Status</dt><dd>@runStatusBadge(row.Run.Status)</dd>
		<dt class="text-muted-foreground">Started</dt><dd class="tabular-nums">{ fmtTime(row.Run.StartedAtNs) }</dd>
		<dt class="text-muted-foreground">Ended</dt>
		<dd class="tabular-nums">
			if row.Run.EndedAtNs.Valid {
				{ fmtTime(row.Run.EndedAtNs.Int64) }
			} else {
				—
			}
		</dd>
		<dt class="text-muted-foreground">Files</dt><dd class="tabular-nums">{ fmt.Sprintf("%d", row.Run.FileCount) }</dd>
		if row.Run.Shallow.Valid {
			<dt class="text-muted-foreground">Mode</dt><dd>@shallowBadge(row.Run.Shallow)</dd>
		}
		if p.Stage != "" && p.Stage != runevents.StageDone {
			<dt class="text-muted-foreground">Progress</dt>
			<dd class="tabular-nums">{ progressText(p) }</dd>
		}
	</div>
}

// progressText renders one progress datapoint inline. Kept template-side
// because the formatting differs per stage (file-count for index, bytes
// for sync) and tying it to the wire shape keeps the SSE pipe straight.
func progressText(p runevents.Progress) string {
	switch {
	case p.BytesTotal > 0:
		return fmt.Sprintf("%s · %s / %s", p.Stage, humanBytes(p.BytesDone), humanBytes(p.BytesTotal))
	case p.BytesDone > 0:
		return fmt.Sprintf("%s · %s", p.Stage, humanBytes(p.BytesDone))
	case p.Total > 0:
		return fmt.Sprintf("%s · %d / %d", p.Stage, p.Done, p.Total)
	case p.Done > 0:
		return fmt.Sprintf("%s · %d", p.Stage, p.Done)
	}
	return p.Stage
}
